{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@systemfsoftware/tsconfig/bundler/no-dom/library-monorepo", "@systemfsoftware/tsconfig/effect"],
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/**/*.schema.ts",
    "apps/**/*.workflow.ts",
    "packages/**/*.schema.ts",
    "packages/**/*.workflow.ts",
    "oxlint.config.ts"
  ]
}
