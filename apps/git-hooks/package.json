{
  "bin": {
    "git-hooks": "./dist/main.js"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-rc.112",
    "@systemfsoftware/cli-adapter": "workspace:*",
    "@systemfsoftware/effect-cell-types": "^6.0.1",
    "@systemfsoftware/git-adapter": "workspace:*",
    "@systemfsoftware/git-hooks-engine": "workspace:*",
    "@systemfsoftware/process-adapter": "workspace:*",
    "@systemfsoftware/release-language": "workspace:*",
    "effect": "^4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0-rc.112",
    "@systemfsoftware/tsconfig": "^1.3.3",
    "@types/node": "^24",
