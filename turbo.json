{
  "$schema": "https://v2-10-1.turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "TMPDIR",
    "XDG_CACHE_HOME"
  ],
  "tasks": {
    "build": {
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "tsdown.config.*"
      ],
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "package": {
      "outputLogs": "new-only",
      "inputs": [
        "dist/main.js",
        "package.json"
      ],
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "//#typecheck:node": {
      "outputLogs": "errors-only",
      "inputs": [
        "tsconfig.node.json",
        "commitlint.config.ts",
        ".lintstagedrc.js"
      ],
      "outputs": [],
      "cache": true
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.fast-check.setup.ts",
        "vitest.config.ts",
        "vitest.config.*",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CHANGELOG.md"
      ],
      "outputLogs": "errors-only",
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": [],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT",
        "FC_SEED",
        "FC_PATH"
      ],
      "passThroughEnv": [
        "DOCKER_HOST",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "TESTCONTAINERS_RYUK_DISABLED"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "oxlint.config.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NODE_ENV",
        "GITHUB_ACTIONS",
        "OXLINT_FORMAT",
        "AGENT"
      ],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
