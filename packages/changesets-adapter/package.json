{
  "name": "@systemfsoftware/changesets-adapter",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": ["dist"],
  "exports": {
    ".": { "@systemfsoftware/source": "./src/index.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": { ".": "./dist/index.js", "./package.json": "./package.json" }
  },
  "scripts": {
    "build": "rimraf dist && tsdown",
    "clean": "rimraf dist",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit --incremental && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@changesets/apply-release-plan": "8.1.1",
    "@changesets/assemble-release-plan": "7.0.0",
    "@changesets/config": "4.0.1",
    "@changesets/read": "1.0.1",
    "@manypkg/get-packages": "3.1.0",
    "@systemfsoftware/release-language": "workspace:*",
    "effect": "^4.0.0-rc.112"
  },
  "devDependencies": {
    "@systemfsoftware/tsconfig": "^1.3.3",
    "@types/node": "^24",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^7",
    "vitest": "4.1.11"
  }
}
